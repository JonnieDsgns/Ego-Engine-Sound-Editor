<Window x:Class="EngineSoundTool.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EngineSoundTool" ThemeMode="Dark" Title="Ego Engine Audio Editor" Width="1320" Height="940" MinWidth="1000" MinHeight="800" Background="#1F1F1F" Foreground="#FCFCFC" FontFamily="Segoe UI" FontSize="14" WindowStyle="None" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Background" Value="#1A1A1A"/><Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#292929"/><Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Foreground" Value="#FAFAFA"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Surface" Background="Transparent" Padding="8"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#303829"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#435723"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><DataTrigger Binding="{Binding IsModified}" Value="True"><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome><WindowChrome GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="10"/></WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="140"/><RowDefinition Height="*"/><RowDefinition Height="1"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="titleBar">
            <Grid.Background><ImageBrush ImageSource="Images/Background_Branding_26.png" Stretch="UniformToFill"/></Grid.Background>
            <StackPanel>
                <Border Height="44">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0.5,1">
                            <LinearGradientBrush.RelativeTransform>
                                <TransformGroup>
                                    <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                    <SkewTransform CenterX="0.5" CenterY="0.5"/>
                                    <RotateTransform Angle="90" CenterX="0.5" CenterY="0.5"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="#B21F1F1F" Offset="0"/><GradientStop Color="#001F1F1F" Offset="1"/>
                            <GradientStop Color="#001F1F1F" Offset="1"/>
                        </LinearGradientBrush></Border.Background>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="minimizeButton" Content="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="10" Width="44" Height="44" Background="Transparent" BorderBrush="Transparent" Foreground="#F2F2F2" ToolTip="Minimize"/>
                        <Button x:Name="maximizeButton" Content="&#xE922;" FontFamily="Segoe Fluent Icons" FontSize="10" Width="44" Height="44" Background="Transparent" BorderBrush="Transparent" Foreground="#F2F2F2" ToolTip="Maximize / Restore"/>
                        <Button x:Name="closeButton" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="10" Width="44" Height="44" Background="Transparent" BorderBrush="Transparent" Foreground="#F2F2F2" ToolTip="Close"/>
                    </StackPanel>
                </Border>
                <Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Image Grid.Column="0" x:Name="toolTitle" Source="Images/toolName.png" Height="60" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <Image Grid.Column="1" x:Name="brandLogo" Source="Images/JonnieDesignsNoBG.png" Height="30" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="Logo_Click" ToolTip="Open JonnieDesigns on Patreon"/>
                </Grid>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="24" Background="#1F1F1F">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <WrapPanel x:Name="toolbar" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Text="Recorded sample preview · Replacement: mono, PCM16, 48 kHz, identical sample count." Foreground="#AAAAAA" FontSize="13" Margin="0,0,0,16" TextWrapping="Wrap" ToolTip="Dynamic in-game engine playback is not simulated. All other BDL data remains unchanged."/>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Audio Bundles" Foreground="#AAAAAA" FontSize="13" Margin="0,0,0,8"/>
                    <TextBox x:Name="search" DockPanel.Dock="Top" Margin="0,0,0,10" ToolTip="Search by filename or path"/>
                    <ListBox x:Name="bundles" Padding="6"/>
                </DockPanel>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="documentTitle" Text="Open a .bdl file" Foreground="#AAAAAA" FontSize="13" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>
                    <Grid Grid.Row="1" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Section Pair" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox x:Name="pairs" Grid.Column="1" MinWidth="160" HorizontalAlignment="Left"/>
                    </Grid>
                    <ListBox x:Name="sections" Grid.Row="2" Height="90" Margin="0,0,0,12"/>
                    <Border Grid.Row="3" Background="#1A1A1A" BorderBrush="#292929" BorderThickness="0.5" CornerRadius="4"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><local:PairAudioView x:Name="visualization"/></ScrollViewer></Border>
                    <StackPanel Grid.Row="4" Margin="0,12,0,0">
                        <TextBlock x:Name="details" Foreground="#AAAAAA" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <WrapPanel x:Name="transport"><TextBlock x:Name="playback" Foreground="#ECECEC" VerticalAlignment="Center" Margin="8,0"/></WrapPanel>
                        <WrapPanel x:Name="editing" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
            <TextBlock x:Name="status" Grid.Row="3" TextWrapping="Wrap" FontSize="13" Foreground="#AAAAAA" Margin="0,16,0,4"/>
        </Grid>
        <Border Grid.Row="2" Background="#282828"/>
        <DockPanel Grid.Row="3" Margin="24,12">
            <TextBlock Text="Disclaimer: AI was used in the creation of this tool" Foreground="#555555" FontSize="12"/>
            <TextBlock Text="Version 1.1.0  |  Created by JonnieDesigns" Foreground="#555555" FontSize="12" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
