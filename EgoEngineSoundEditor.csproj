<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Include the publish runtime in normal Visual Studio/NuGet restores. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RootNamespace>EgoEngineSoundEditor</RootNamespace>
    <!-- Keep the WPF temporary project editorconfig below Windows path limits. -->
    <GeneratedMSBuildEditorConfigFile>$(MSBuildProjectDirectory)\obj\g.editorconfig</GeneratedMSBuildEditorConfigFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>enginesoundeditoricon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Images\Background_Branding_26.png" Link="Images/Background_Branding_26.png" />
    <Resource Include="Images\JonnieDesignsNoBG.png" Link="Images/JonnieDesignsNoBG.png" />
      <Resource Include="Images\toolName.png" Link="Images/toolName.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Distribution\*.txt;Distribution\*.md">
      <TargetPath>license\%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Content Include="enginesoundeditoricon.ico" />
  </ItemGroup>
</Project>
